# Copy to .env and replace placeholder values for local use.
TASKBOT_DATABASE_URL=postgresql+asyncpg://taskbot:replace-me@localhost:5432/taskbot
TASKBOT_DATABASE_CONNECT_TIMEOUT_SECONDS=3
TASKBOT_BOT_TOKEN=8794054533:AAHL7wqPfzAMf8z7nYfqjJR97VTZHfJmAPc
TASKBOT_TELEGRAM_BOT_USERNAME=academ_taskbot
# Exact browser origin (no trailing slash). Must match BotFather /setdomain.
TASKBOT_WEB_ORIGIN=http://localhost:3000
# Set false only for local HTTP development; keep true with HTTPS.
TASKBOT_SESSION_COOKIE_SECURE=false
TASKBOT_SESSION_HOURS=24
TASKBOT_LOGIN_MAX_AGE_SECONDS=300

# Local-only development login. Keep disabled outside your own computer.
TASKBOT_APP_ENV=production
TASKBOT_DEV_LOGIN_ENABLED=false
TASKBOT_DEV_LOGIN_TELEGRAM_ID=
TASKBOT_DEV_LOGIN_SECRET=

# The worker requires an explicit --run. Telegram delivery also requires both settings below.
TASKBOT_NOTIFICATION_DELIVERY_ENABLED=false
TASKBOT_NOTIFICATION_TRANSPORT=dry_run
TASKBOT_WORKER_POLL_SECONDS=15
TASKBOT_WORKER_BATCH_SIZE=50
TASKBOT_WORKER_MAX_ATTEMPTS=5
TASKBOT_WORKER_RETRY_BASE_SECONDS=30
TASKBOT_WORKER_LEASE_SECONDS=120
TASKBOT_WORKDAYS=0,1,2,3,4,5
TASKBOT_WORKDAY_START=10:00
TASKBOT_WORKDAY_END=19:00
TASKBOT_REACTION_WORK_MINUTES=240

