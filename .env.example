# Reference only. Configure production variables in each service's secret/environment store.
# Empty required values must be supplied by the operator. Never commit .env or .env.local.

# API + Telegram bot + Worker + Alembic: existing Supabase PostgreSQL Session Pooler.
# SQLAlchemy must use the postgresql+asyncpg driver. Keep the full URL server-side.
# Harmless local placeholder for the config test; replace before any real run.
TASKBOT_DATABASE_URL=postgresql+asyncpg://taskbot:replace-me@localhost:5432/taskbot
# API + bot + Worker: database connect timeout, seconds.
TASKBOT_DATABASE_CONNECT_TIMEOUT_SECONDS=3

# API + bot; Worker also needs this only when Telegram delivery is enabled.
# The same bot token verifies Telegram Mini App initData on the API.
TASKBOT_BOT_TOKEN=
# Optional display/configuration hint; this does not grant access.
TASKBOT_TELEGRAM_BOT_USERNAME=

# Bot: permanent public HTTPS Mini App URL for /start and setChatMenuButton.
TASKBOT_WEBAPP_URL=
# API: exact same Mini App HTTPS origin, without a trailing slash or path.
# Used for Origin checks and CORS; it is not the API's own origin.
TASKBOT_WEB_ORIGIN=
# Vercel Next.js server ONLY: permanent public HTTPS FastAPI origin, no path.
# Set in Vercel Production environment BEFORE build. Never prefix this key with NEXT_PUBLIC_.
TASKBOT_API_UPSTREAM=

# API: Secure session cookie must stay true in production.
TASKBOT_SESSION_COOKIE_SECURE=true
# API: server session duration, hours, and maximum Telegram proof age, seconds.
TASKBOT_SESSION_HOURS=24
TASKBOT_LOGIN_MAX_AGE_SECONDS=300
# API + bot + Worker: production disables the local login path.
TASKBOT_APP_ENV=production
TASKBOT_DEV_LOGIN_ENABLED=false
# Local development only: leave unset in production.
TASKBOT_DEV_LOGIN_TELEGRAM_ID=
TASKBOT_DEV_LOGIN_SECRET=
# Vercel: keep false or unset in production; local UI only.
NEXT_PUBLIC_TASKBOT_DEV_LOGIN_ENABLED=false
# Local development UI only. Do not set NEXT_PUBLIC_TASKBOT_API_URL in Vercel production.
NEXT_PUBLIC_TASKBOT_API_URL=

# API only: existing Supabase project's HTTPS API origin and server-only secret key.
# Create a PRIVATE Storage bucket with 10 MiB maximum and PDF/PNG/JPEG/TXT MIME allowlist.
# Set TASKBOT_ATTACHMENT_BUCKET to taskbot-attachments after creating it.
# The API requires all three values together and checks that the bucket is private.
TASKBOT_SUPABASE_URL=
TASKBOT_SUPABASE_SECRET_KEY=
TASKBOT_ATTACHMENT_BUCKET=

# Worker only: no queue processing occurs until the process is explicitly started.
# false also prevents Telegram delivery; dry_run with delivery enabled marks sends simulated.
TASKBOT_NOTIFICATION_DELIVERY_ENABLED=false
TASKBOT_NOTIFICATION_TRANSPORT=dry_run
# Worker polling, batch, bounded retry and lease settings.
TASKBOT_WORKER_POLL_SECONDS=15
TASKBOT_WORKER_BATCH_SIZE=50
TASKBOT_WORKER_MAX_ATTEMPTS=5
TASKBOT_WORKER_RETRY_BASE_SECONDS=30
TASKBOT_WORKER_LEASE_SECONDS=120
# Worker schedule in Asia/Tashkent: weekday numbers 0=Mon ... 6=Sun.
TASKBOT_WORKDAYS=0,1,2,3,4,5
TASKBOT_WORKDAY_START=10:00
TASKBOT_WORKDAY_END=19:00
# Worker assignment reaction threshold in working minutes.
TASKBOT_REACTION_WORK_MINUTES=240

